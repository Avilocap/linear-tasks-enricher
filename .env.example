# Port for the webhook server
PORT=3000

# Linear webhook signing secret for issue webhooks
LINEAR_WEBHOOK_SECRET=

# Linear webhook signing secret for comment webhooks (Devora trigger)
LINEAR_COMMENT_WEBHOOK_SECRET=

# Linear API key for updating issues and creating comments
LINEAR_API_KEY=

# Filter by team key (e.g. "ENG"). Leave empty to accept all teams.
LINEAR_TEAM_KEY=

# Root directory containing z2-backend and z2-frontend
# Defaults to the project root if not set
PROJECT_ROOT=

# OpenAI API key for Whisper video transcription
OPENAI_API_KEY=

# GitHub webhook signing secret (for PR merge/close events)
GITHUB_WEBHOOK_SECRET=

# GitHub token for creating PRs via gh CLI (needs repo scope)
GITHUB_TOKEN=
