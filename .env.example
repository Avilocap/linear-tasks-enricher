# Port for the webhook server
PORT=3000

# Filter by team key (e.g. "ENG"). Leave empty to accept all teams.
LINEAR_TEAM_KEY=

# Root directory containing z2-backend and z2-frontend
# Defaults to the project root if not set
PROJECT_ROOT=

# ─── Enrique (enrichment agent) OAuth App ───────────────────────────────
# Create in Linear Settings → API → OAuth Applications
# Webhook URL: https://your-domain/webhook/agent/enrique
# Scopes: read,write,app:assignable,app:mentionable
ENRIQUE_CLIENT_ID=
ENRIQUE_CLIENT_SECRET=
ENRIQUE_WEBHOOK_SECRET=

# ─── Devora (implementation agent) OAuth App ────────────────────────────
# Create in Linear Settings → API → OAuth Applications
# Webhook URL: https://your-domain/webhook/agent/devora
# Scopes: read,write,app:assignable,app:mentionable
DEVORA_CLIENT_ID=
DEVORA_CLIENT_SECRET=
DEVORA_WEBHOOK_SECRET=

# ─── Shared OAuth redirect URI ──────────────────────────────────────────
OAUTH_REDIRECT_URI=https://your-domain/oauth/callback

# ─── External services ──────────────────────────────────────────────────

# OpenAI API key for Whisper video transcription
OPENAI_API_KEY=

# GitHub webhook signing secret (for PR merge/close events)
GITHUB_WEBHOOK_SECRET=

# GitHub token for creating PRs via gh CLI (needs repo scope)
GITHUB_TOKEN=
